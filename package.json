{
  "name": "rdf-graph-viewer",
  "version": "1.0.0",
  "description": "A visualization tool for large RDF/TTL datasets",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "ts-node-dev --respawn --transpile-only server/index.ts",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "test": "jest",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "n3": "^1.17.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/n3": "^1.16.0",
    "@types/node": "^18.16.3",
    "@types/uuid": "^9.0.1",
    "concurrently": "^8.0.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.4"
  }
}